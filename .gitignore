# memkraft memory layer: track the plain-Markdown source-of-truth
# (entities/, live-notes/, decisions/, facts/, sessions/, RESOLVER.md, ...).
# Ignore regenerable derived caches (rebuilt by `memkraft index` / `link_scan`).
memory/.memkraft/
memory/graph.db

# Claude Code machine-local hook config (impeccable design detector wiring).
# Gitignored per impeccable convention. Fresh clone → `npx impeccable install`
# restores it. (Skill files under .claude/skills/ ARE tracked.)
.claude/settings.local.json

# impeccable-ignore-start
# Ephemeral output, runtime state, and per-dev overrides for the impeccable
# design skill. Unanchored: .impeccable may sit at repo root or a nested
# workspace. Shared artifacts stay tracked: config.json, live/config.json,
# design.json, critique/*.md. See IMPECCABLE-KILAVUZ.md.
.impeccable/config.local.json
.impeccable/hook.cache.json
.impeccable/hook.pending.json
.impeccable/*.png
.impeccable/live/server.json
.impeccable/live/sessions/
.impeccable/live/previews/
.impeccable/live/annotations/
.impeccable/live/cache/
.impeccable/live/manual-edit-apply-transaction.json
.impeccable/live/manual-edit-events.jsonl
.impeccable/live/manual-edit-evidence/
.impeccable/live/pending-manual-edits.json
.impeccable/live/deferred-svelte-component-accepts.json
.impeccable/live/*.png
# impeccable-ignore-end

